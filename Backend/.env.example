# FitMeister Backend Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/fitmeister_db?schema=public

# Security & Secrets (Minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters
SESSION_SECRET=replace_with_a_secure_random_session_secret_minimum_32_characters

# CORS
CLIENT_ORIGIN=http://localhost:5173
