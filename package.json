{
  "name": "fitmeister-monorepo",
  "version": "2.0.0",
  "description": "Enterprise Full-Stack Fitness & Gym Studio Management Platform",
  "private": true,
  "workspaces": [
    "Backend",
    "Frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix Backend run dev",
    "dev:frontend": "npm --prefix Frontend run dev",
    "build:backend": "npm --prefix Backend run build",
    "build:frontend": "npm --prefix Frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test": "npm --prefix Backend test",
    "prisma:generate": "npm --prefix Backend run prisma:generate",
    "prisma:seed": "npm --prefix Backend run prisma:seed",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "fitness",
    "gym-management",
    "scheduling",
    "typescript",
    "react",
    "vite",
    "prisma",
    "postgresql",
    "express"
  ],
  "author": "S Sindid Ahmed Nabil <nabilpwqz@gmail.com>",
  "license": "MIT"
}
